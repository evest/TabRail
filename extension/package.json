{
  "name": "tabrail-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && vite build --config vite.standalone.config.ts",
    "build:ext": "vite build",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "preview:standalone": "vite --config vite.standalone.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen-key": "node scripts/gen-key.mjs"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@types/chrome": "0.3.7",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
