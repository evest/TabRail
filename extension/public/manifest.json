{
  "manifest_version": 3,
  "name": "TabRail",
  "description": "Always-visible sidebar listing every Chrome window and tab.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "storage", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open TabRail sidebar"
  },
  "commands": {
    "focus-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Open or focus the TabRail sidebar",
      "global": true
    }
  },
  "key": ""
}
