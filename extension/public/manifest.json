{
  "manifest_version": 3,
  "name": "TabRail",
  "description": "Always-visible sidebar listing every Chrome window and tab.",
  "version": "0.8.1",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "storage", "favicon"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open TabRail sidebar",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "commands": {
    "focus-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Open or focus the TabRail sidebar",
      "global": true
    }
  },
  "key": ""
}
